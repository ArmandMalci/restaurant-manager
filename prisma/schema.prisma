generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders             Order[]
  shifts             Shift[]
  refreshTokens      RefreshToken[]
  pushSubscriptions  PushSubscription[]

  @@map("staff")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  staffId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Table {
  id        String      @id @default(uuid())
  number    Int         @unique
  seats     Int
  status    TableStatus @default(available)
  seatedAt  DateTime?
  posX      Float?
  posY      Float?
  shape     String      @default("square")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders       Order[]
  reservations Reservation[]

  @@map("tables")
}

model MenuCategory {
  id        String     @id @default(uuid())
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String          @id @default(uuid())
  name        String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  categoryId  String
  available   Boolean         @default(true)
  station     KitchenStation?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category        MenuCategory           @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  inventoryUsages InventoryUsage[]
  modifierGroups  MenuItemModifierGroup[]

  @@map("menu_items")
}

model ModifierGroup {
  id            String                @id @default(uuid())
  name          String
  selectionType ModifierSelectionType @default(single)
  required      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  options       ModifierOption[]
  menuItems     MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id         String        @id @default(uuid())
  groupId    String
  name       String
  priceDelta Decimal       @default(0) @db.Decimal(10, 2)
  sortOrder  Int           @default(0)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifier_options")
}

model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model Order {
  id        String      @id @default(uuid())
  tableId   String
  staffId   String
  status    OrderStatus @default(draft)
  notes     String?
  sentAt    DateTime?
  readyAt   DateTime?
  servedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  table Table      @relation(fields: [tableId], references: [id])
  staff Staff      @relation(fields: [staffId], references: [id])
  items OrderItem[]
  bill  Bill?

  @@map("orders")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  status     OrderItemStatus @default(pending)
  notes      String?
  firedAt    DateTime?
  readyAt    DateTime?
  unitPrice  Decimal         @db.Decimal(10, 2) @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem            @relation(fields: [menuItemId], references: [id])
  modifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id               String    @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  name             String
  priceDelta       Decimal   @db.Decimal(10, 2) @default(0)
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_modifiers")
}

model Reservation {
  id         String    @id @default(uuid())
  tableId    String
  guestName  String
  guestEmail String?
  guestPhone String?
  partySize  Int
  date       DateTime
  notes      String?
  seatedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  table Table @relation(fields: [tableId], references: [id])

  @@map("reservations")
}

model Shift {
  id        String    @id @default(uuid())
  staffId   String
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@map("shifts")
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  unit      String
  quantity  Decimal  @db.Decimal(10, 3)
  minStock  Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages InventoryUsage[]

  @@map("inventory_items")
}

model InventoryUsage {
  id              String  @id @default(uuid())
  inventoryItemId String
  menuItemId      String
  quantityUsed    Decimal @db.Decimal(10, 3)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])

  @@map("inventory_usages")
}

model Bill {
  id        String   @id @default(uuid())
  orderId   String   @unique
  subtotal  Decimal  @db.Decimal(10, 2)
  discountPct Decimal @db.Decimal(5, 2) @default(0)
  tax       Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  paid      Boolean  @default(false)
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id])
  payments Payment[]

  @@map("bills")
}

model Payment {
  id        String   @id @default(uuid())
  billId    String
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  createdAt DateTime @default(now())
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  @@map("payments")
}

enum KitchenStation {
  grill
  cold
  bar
  pass
}

enum ModifierSelectionType {
  single
  multi
}

enum StaffRole {
  manager
  waiter
  kitchen
  host
}

enum TableStatus {
  available
  occupied
  reserved
}

enum OrderStatus {
  draft
  sent
  in_progress
  ready
  served
}

enum OrderItemStatus {
  pending
  in_progress
  ready
}

model RestaurantSettings {
  id           String   @id @default("default")
  name         String   @default("My Restaurant")
  description  String?
  phone        String?
  email        String?
  address      String?
  openingHours String?
  updatedAt    DateTime @updatedAt

  @@map("restaurant_settings")
}

model PushSubscription {
  id        String   @id @default(uuid())
  staffId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}
