{
  "name": "restaurant-manager",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "prepare": "husky",
    "gen:api": "pnpm --filter @restaurant/api gen:spec && pnpm --filter @restaurant/web gen:api"
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "biome check --write --no-errors-on-unmatched",
      "pnpm --filter @restaurant/api exec eslint --fix"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "pnpm --filter @restaurant/web exec eslint --fix"
    ],
    "packages/**/*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.{json,md}": [
      "biome format --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/pg": "^8.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "turbo": "^2.9.18",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  }
}
